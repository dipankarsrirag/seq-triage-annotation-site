NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. JSON array of login accounts. Never prefix these with
# NEXT_PUBLIC_ - they must not end up in the client bundle.
# role is "clinician" or "admin". displayName is what gets stored as the
# `clinician` value in Supabase and shown in the UI.
AUTH_USERS=[{"username":"clinician1","password":"change-me","displayName":"Dr. First Clinician","role":"clinician"},{"username":"clinician2","password":"change-me","displayName":"Dr. Second Clinician","role":"clinician"},{"username":"admin","password":"change-me","displayName":"Admin (test)","role":"admin"}]

# Server-only. Random secret used to sign session cookies. Generate with:
# openssl rand -hex 32
SESSION_SECRET=change-me
